<button class="nav-toggle" data-action="nav#toggle" data-nav-target="toggle" aria-label="Menu">
  <i class="fa-solid fa-bars"></i>
  <i class="fa-solid fa-xmark"></i>
</button>

<aside class="sidebar" data-nav-target="sidebar">
  <%= link_to root_path, class: "brand" do %>
    <span class="sur">Andrius</span>
    <span class="given">Dereviancenko</span>
  <% end %>

  <nav class="nav">
    <% nav_items = [
      { label: "Home",         path: root_path },
      { label: "Bio",          path: bio_path },
      { label: "Live",         path: live_path },
      { label: "Videos",       path: videos_path },
      { label: "Discography",  path: discography_path },
      { label: "Lessons",      path: lessons_path },
      { label: "Store",        path: store_path },
      { label: "Contact",      path: contact_path },
    ] %>
    <% nav_items.each do |item| %>
      <%= link_to item[:path], class: "#{current_page?(item[:path]) ? 'active' : ''}", data: { action: "nav#toggle" } do %>
        <%= item[:label] %>
      <% end %>
    <% end %>
  </nav>

    <div class="socials">
      <a href="https://www.instagram.com/derevi89/" target="_blank" rel="noopener" title="Instagram">
        <i class="fa-brands fa-instagram"></i>
      </a>
      <a href="https://12tribesofmars.bandcamp.com/album/hidden-sun" target="_blank" rel="noopener" title="Bandcamp">
        <i class="fa-brands fa-bandcamp"></i>
      </a>
      <a href="https://linktr.ee/andriusmusic" target="_blank" rel="noopener" title="Linktree">
        <i class="fa-solid fa-link"></i>
      </a>
      <a href="https://www.youtube.com/@andriusdereviancenko7791" target="_blank" rel="noopener" title="YouTube">
        <i class="fa-brands fa-youtube"></i>
      </a>
    </div>
</aside>
