<div class="home">
  <div class="home-hero" data-controller="carousel">
    <div class="hero-grain"></div>

    <div class="hero-overlay">
      <div class="hero-top"></div>

      <div class="hero-carousel" data-carousel-target="track">
        <div class="hero-carousel-track">
          <% slides = @carousel_images.any? ? @carousel_images : [:default] %>
          <% slides.each_with_index do |slide, i| %>
            <div class="hero-carousel-slide <%= 'is-active' if i == 0 %>" data-carousel-target="slide">
              <% if slide == :default %>
                <%= image_tag "carousel-01.png", alt: "Andrius Dereviancenko" %>
              <% else %>
                <%= image_tag slide.image, alt: slide.alt_text.presence || "Andrius Dereviancenko" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="hero-carousel-dots">
          <% slides.each_with_index do |_, i| %>
            <button class="hero-carousel-dot <%= 'is-active' if i == 0 %>" data-carousel-target="dot" data-action="click->carousel#goTo" data-index="<%= i %>" aria-label="Slide <%= i + 1 %>"></button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @home_blocks.any? %>
    <div class="home-content">
      <%= render partial: "pages/home_block", collection: @home_blocks, as: :block %>
    </div>
  <% end %>
</div>
